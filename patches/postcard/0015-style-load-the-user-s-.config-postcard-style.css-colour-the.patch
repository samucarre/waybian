From 425e2e320710057ed1af115b3a2e9c1ccbf29392 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <soyminero11yt@gmail.com>
Date: Tue, 3 Nov 2026 09:34:18 +0100
Subject: [PATCH 15/16] style: load the user's ~/.config/postcard/style.css;
 colour the editor from the window's style

A stylesheet in the user's config dir is applied at USER priority over
libadwaita's palette and the app's own style.css, the way gtk.css would, but
for Postcard alone: a translucent window, another palette.

The composer no longer carries two hardcoded palettes. It reads the window's
foreground and the accent colour (GTK's, after any user stylesheet) and hands
them to the page as CSS variables on <html>, outside the body, so they never
travel with the message; a scheme change restyles in place.
---
 src/postcard/application.py     | 22 ++++++++++++++++-
 src/postcard/composer_window.py | 42 ++++++++++++++++++++-------------
 2 files changed, 47 insertions(+), 17 deletions(-)

diff --git a/src/postcard/application.py b/src/postcard/application.py
index d195c3b..f542e6c 100644
--- a/src/postcard/application.py
+++ b/src/postcard/application.py
@@ -1,5 +1,6 @@
 import logging
 from collections.abc import Callable
+from pathlib import Path
 from gettext import gettext as _
 
 import gi
@@ -8,7 +9,7 @@ gi.require_version("Adw", "1")
 gi.require_version("Gdk", "4.0")
 gi.require_version("Gtk", "4.0")
 
-from gi.repository import Adw, Gio, GLib
+from gi.repository import Adw, Gdk, Gio, GLib, Gtk
 
 from .composer_window import composer_for_mailto
 from .core import APP_ID
@@ -69,6 +70,7 @@ class PostcardApplication(Adw.Application):
         Adw.Application.do_startup(self)
         # Before any WebView exists: the sandbox paths can't change once a web process runs.
         expose_graphics_driver_paths()
+        load_user_stylesheet()
         self.tray.start()
         self.settings.connect(
             "changed::run-in-background", self._on_run_in_background_changed
@@ -157,3 +159,21 @@ class PostcardApplication(Adw.Application):
 
     def on_new_window_action(self, *_args: object) -> None:
         PostcardMainWindow(self, self.db, self.settings).present()
+
+
+def load_user_stylesheet() -> None:
+    """Apply ~/.config/postcard/style.css, the user's own look, over the theme.
+
+    Loaded at USER priority, so it overrides both libadwaita's palette (the
+    --window-bg-color family) and the app's style.css, the way gtk.css would,
+    but for this app alone.
+    """
+    path = Path(GLib.get_user_config_dir()) / "postcard" / "style.css"
+    if not path.is_file():
+        return
+    provider = Gtk.CssProvider()
+    provider.load_from_path(str(path))
+    Gtk.StyleContext.add_provider_for_display(
+        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER
+    )
+    logger.info("user stylesheet loaded from %s", path)
diff --git a/src/postcard/composer_window.py b/src/postcard/composer_window.py
index adab2a7..769feb5 100644
--- a/src/postcard/composer_window.py
+++ b/src/postcard/composer_window.py
@@ -35,7 +35,7 @@ from .core.threader import NO_SUBJECT
 logger = logging.getLogger(__name__)
 
 _EDITOR_PAGE = """<!DOCTYPE html>
-<html class="{scheme}">
+<html style="{palette}">
 <head>
 <meta charset="utf-8">
 <style>
@@ -46,19 +46,19 @@ _EDITOR_PAGE = """<!DOCTYPE html>
     font-family: {family};
     font-size: {size}pt;
     line-height: 1.5;
-    color: #241f31;
+    color: var(--fg);
     background: transparent;
     outline: none;
   }}
-  a {{ color: #1c71d8; }}
-  blockquote {{ color: #5e5c64; }}
-  .signature {{ color: #5e5c64; }}
-  /* The window's own style manager says whether it is dark: WebKit's
-     prefers-color-scheme follows the GTK setting, which libadwaita leaves
-     alone when the scheme comes from the portal or ADW_DEBUG_COLOR_SCHEME. */
-  html.dark body {{ color: #f6f5f4; }}
-  html.dark a {{ color: #78aeed; }}
-  html.dark blockquote, html.dark .signature {{ color: #c0bfbc; }}
+  /* The palette is the window's own (GTK's foreground and accent colours),
+     set as variables on <html>: WebKit's prefers-color-scheme follows the
+     GTK prefer-dark setting, which libadwaita leaves alone when the scheme
+     comes from the portal or ADW_DEBUG_COLOR_SCHEME, and a user stylesheet
+     may recolour the window anyway. The variables live outside <body>, so
+     they never travel with the message. */
+  a {{ color: var(--accent); }}
+  blockquote {{ color: var(--muted); }}
+  .signature {{ color: var(--muted); }}
 </style>
 </head>
 <body contenteditable="true">{body}</body>
@@ -595,7 +595,7 @@ class PostcardComposerWindow(Adw.Window):
                 family=family,
                 size=size,
                 body=self._body_html,
-                scheme="dark" if style_manager.get_dark() else "",
+                palette=self._editor_palette(),
             ),
             None,
         )
@@ -605,11 +605,21 @@ class PostcardComposerWindow(Adw.Window):
         )
         self.connect("destroy", self._on_destroy)
 
-    def _on_dark_changed(self, manager: Adw.StyleManager, _pspec: object) -> None:
-        # Flip the class instead of reloading: a reload would drop the draft.
+    def _editor_palette(self) -> str:
+        """The editor's colours as CSS variables, taken from the window's style."""
+        fg = self.get_color()
+        muted = Gdk.RGBA(red=fg.red, green=fg.green, blue=fg.blue, alpha=fg.alpha * 0.7)
+        accent = Adw.StyleManager.get_default().get_accent_color_rgba()
+        return (
+            f"--fg: {fg.to_string()}; --muted: {muted.to_string()}; "
+            f"--accent: {accent.to_string()};"
+        )
+
+    def _on_dark_changed(self, _manager: Adw.StyleManager, _pspec: object) -> None:
+        # Restyle in place instead of reloading: a reload would drop the draft.
         self._run_script(
-            "document.documentElement.classList.toggle('dark', %s);"
-            % json.dumps(manager.get_dark())
+            "document.documentElement.style.cssText = %s;"
+            % json.dumps(self._editor_palette())
         )
 
     def _on_destroy(self, _window: Gtk.Window) -> None:
