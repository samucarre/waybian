From 051ba85910b78f8fbb0ffe886e04ec93b7023096 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <soyminero11yt@gmail.com>
Date: Thu, 29 Oct 2026 13:24:35 +0100
Subject: [PATCH] fix: keep the reading pane still when a click focuses a
 message body

---
 src/ui/main-window.blp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/ui/main-window.blp b/src/ui/main-window.blp
index 87436ee..5c8160a 100644
--- a/src/ui/main-window.blp
+++ b/src/ui/main-window.blp
@@ -315,8 +315,17 @@ template $PostcardMainWindow: Adw.ApplicationWindow {
 
                         styles ["reader-body"]
 
-                        child: Gtk.Box thread_box {
-                          orientation: vertical;
+                        // Left to itself GTK wraps thread_box in a viewport that
+                        // scrolls to the focused child: a click on a body focuses
+                        // its WebView, the pane jumps to the body's top between
+                        // press and release, and the link under the pointer never
+                        // gets its click.
+                        child: Gtk.Viewport {
+                          scroll-to-focus: false;
+
+                          child: Gtk.Box thread_box {
+                            orientation: vertical;
+                          };
                         };
                       }
                     };
