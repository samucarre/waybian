From 5141119578a2347d96ea5a67c113840249450009 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <soyminero11yt@gmail.com>
Date: Tue, 27 Oct 2026 07:50:46 +0100
Subject: [PATCH] sandbox: expose the session's EGL vendor and driver paths to
 the web process

WebKit's bubblewrap sandbox only sees the system directories, so a Mesa
installed elsewhere (selected through __EGL_VENDOR_LIBRARY_FILENAMES,
LIBGL_DRIVERS_PATH, GBM_BACKENDS_PATH) is invisible to the web process:
libglvnd finds no EGL driver, the process aborts with "Could not create
default EGL display" and every message body stays blank. Call
webkit_web_context_add_path_to_sandbox() for those directories during
startup, before the first web process is spawned.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/meson.build                |  1 +
 src/postcard/application.py    |  3 ++
 src/postcard/webkit_sandbox.py | 55 ++++++++++++++++++++++++++++++++++
 3 files changed, 59 insertions(+)
 create mode 100644 src/postcard/webkit_sandbox.py

diff --git a/src/meson.build b/src/meson.build
index 6dc066c..4b15bd2 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -46,6 +46,7 @@ postcard_sources = [
   'postcard/composer_window.py',
   'postcard/preferences_dialog.py',
   'postcard/tray.py',
+  'postcard/webkit_sandbox.py',
   'postcard/mail_sync.py',
   'postcard/folder_row.py',
 ]
diff --git a/src/postcard/application.py b/src/postcard/application.py
index 316229b..d195c3b 100644
--- a/src/postcard/application.py
+++ b/src/postcard/application.py
@@ -15,6 +15,7 @@
 from .core.store.database import Database
 from .preferences_dialog import PostcardPreferencesDialog
 from .tray import Tray
+from .webkit_sandbox import expose_graphics_driver_paths
 from .window import PostcardMainWindow
 
 logger = logging.getLogger(__name__)
@@ -66,6 +67,8 @@ def __init__(self, version: str) -> None:
 
     def do_startup(self) -> None:
         Adw.Application.do_startup(self)
+        # Before any WebView exists: the sandbox paths can't change once a web process runs.
+        expose_graphics_driver_paths()
         self.tray.start()
         self.settings.connect(
             "changed::run-in-background", self._on_run_in_background_changed
diff --git a/src/postcard/webkit_sandbox.py b/src/postcard/webkit_sandbox.py
new file mode 100644
index 0000000..df2a302
--- /dev/null
+++ b/src/postcard/webkit_sandbox.py
@@ -0,0 +1,55 @@
+"""Let WebKit's sandboxed web processes find the session's graphics drivers.
+
+WebKit runs every web process inside a bubblewrap sandbox that sees the
+system directories and a few well-known user ones, nothing else. When the
+session points libglvnd at a Mesa installed somewhere else (for example a
+driver build under the home directory, selected through
+__EGL_VENDOR_LIBRARY_FILENAMES), the EGL vendor file is invisible inside the
+sandbox: libglvnd finds no EGL implementation, the web process aborts with
+"Could not create default EGL display" and every message body stays blank.
+
+webkit_web_context_add_path_to_sandbox() is the API for exactly this. It must
+run before the first web process is spawned, so the application calls
+expose_graphics_driver_paths() during startup.
+"""
+
+import logging
+import os
+
+import gi
+
+gi.require_version("WebKit", "6.0")
+from gi.repository import WebKit  # noqa: E402
+
+logger = logging.getLogger(__name__)
+
+# Variables naming files (the directory holding them is what gets exposed).
+_FILE_VARS = ("__EGL_VENDOR_LIBRARY_FILENAMES",)
+# Variables naming directories.
+_DIR_VARS = ("__EGL_VENDOR_LIBRARY_DIRS", "LIBGL_DRIVERS_PATH", "GBM_BACKENDS_PATH")
+# Already mounted by WebKit itself; add_path_to_sandbox() also refuses some of them.
+_ALWAYS_VISIBLE = ("/usr/", "/lib", "/etc/", "/dev/", "/proc/", "/sys/")
+
+
+def _paths_from_environment() -> list[str]:
+    paths: list[str] = []
+    for var, is_file in [(v, True) for v in _FILE_VARS] + [(v, False) for v in _DIR_VARS]:
+        for entry in filter(None, os.environ.get(var, "").split(os.pathsep)):
+            path = os.path.realpath(os.path.dirname(entry) if is_file else entry)
+            if path in paths or not os.path.isdir(path) or path.startswith(_ALWAYS_VISIBLE):
+                continue
+            if path in (os.path.expanduser("~"), "/home", "/"):
+                continue
+            paths.append(path)
+    return paths
+
+
+def expose_graphics_driver_paths() -> None:
+    """Mount, read-only, the driver paths the session's variables point at."""
+    paths = _paths_from_environment()
+    if not paths:
+        return
+    context = WebKit.WebContext.get_default()
+    for path in paths:
+        context.add_path_to_sandbox(path, True)
+        logger.info("web process sandbox: exposing %s", path)
