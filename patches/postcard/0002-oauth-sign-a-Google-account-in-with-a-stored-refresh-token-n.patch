index 0000000..0b72964
--- /dev/null
+++ b/src/postcard/core/net/google_oauth.py
@@ -0,0 +1,36 @@
+"""Mint a Google access token from a stored refresh token.
+
+Postcard normally gets XOAUTH2 credentials from GNOME Online Accounts. This
+adds a second source: a refresh token kept in the keyring, exchanged for a
+short-lived access token at sign-in. It lets a Google account be used without
+GOA installed -- the refresh token is obtained once (e.g. imported from another
+mail client the user already authorised) and stored like a password.
+
+The client_id/secret below are Thunderbird's built-in, public OAuth client
+(shipped in its open-source tree); Google treats "installed app" secrets as
+non-confidential, so they identify the client, they do not protect anything.
+"""
+
+import json
+import urllib.parse
+import urllib.request
+
+# Thunderbird's built-in Google OAuth client (public, from its source tree).
+TB_CLIENT_ID = "406964657835-aq8lmia8j95dhl1a2bvharmfk3t1hgqj.apps.googleusercontent.com"
+TB_CLIENT_SECRET = "kSmqreRr0qwBWJgbf5Y-PjSU"
+_TOKEN_ENDPOINT = "https://oauth2.googleapis.com/token"
+
+
+def access_token(refresh_token: str) -> str:
+    """Exchange a refresh token for a fresh access token. Blocks on one HTTPS
+    round trip; call it from the worker thread, as credential_for already is."""
+    data = urllib.parse.urlencode(
+        {
+            "client_id": TB_CLIENT_ID,
+            "client_secret": TB_CLIENT_SECRET,
+            "refresh_token": refresh_token,
+            "grant_type": "refresh_token",
+        }
+    ).encode()
+    with urllib.request.urlopen(_TOKEN_ENDPOINT, data=data, timeout=30) as response:
+        return json.load(response)["access_token"]
diff --git a/src/postcard/core/secrets.py b/src/postcard/core/secrets.py
index 7baff11..b8c4242 100644
--- a/src/postcard/core/secrets.py
+++ b/src/postcard/core/secrets.py
@@ -9,7 +9,8 @@
 
 from . import goa
 from .models.account import Account
-from .net.auth import Credential
+from .net.auth import Credential, MECHANISM_XOAUTH2
+from .net import google_oauth
 
 _SCHEMA = Secret.Schema.new(
     "in.gxanshu.postcard.Account",
@@ -17,6 +18,32 @@
     {"account-id": Secret.SchemaAttributeType.INTEGER},
 )
 
+# A Google refresh token for an account signed in with XOAUTH2 (imported rather
+# than handed over by GOA). Kept separate from the password schema so an account
+# is never both at once.
+_OAUTH_SCHEMA = Secret.Schema.new(
+    "in.gxanshu.postcard.OAuthRefresh",
+    Secret.SchemaFlags.NONE,
+    {"account-id": Secret.SchemaAttributeType.INTEGER},
+)
+
+
+def store_refresh_token(account_id: int, refresh_token: str) -> None:
+    Secret.password_store_sync(
+        _OAUTH_SCHEMA,
+        {"account-id": str(account_id)},
+        Secret.COLLECTION_DEFAULT,
+        f"Postcard account {account_id} (OAuth)",
+        refresh_token,
+        None,
+    )
+
+
+def lookup_refresh_token(account_id: int) -> str | None:
+    return Secret.password_lookup_sync(
+        _OAUTH_SCHEMA, {"account-id": str(account_id)}, None
+    )
+
 
 def store_password(account_id: int, password: str) -> None:
     Secret.password_store_sync(
@@ -46,5 +73,10 @@ def credential_for(account: Account) -> Credential | None:
     if account.goa_id:
         return goa.credential(account.goa_id)
 
+    refresh_token = lookup_refresh_token(account.id)
+    if refresh_token is not None:
+        access_token = google_oauth.access_token(refresh_token)
+        return Credential(account.login_name, access_token, MECHANISM_XOAUTH2)
+
     password = lookup_password(account.id)
     return Credential(account.login_name, password) if password else None
