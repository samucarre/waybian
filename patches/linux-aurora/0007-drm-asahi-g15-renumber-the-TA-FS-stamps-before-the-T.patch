diff --git a/drivers/gpu/drm/asahi/g15/encode.rs b/drivers/gpu/drm/asahi/g15/encode.rs
index 64aebf325489..4715fe873ba2 100644
--- a/drivers/gpu/drm/asahi/g15/encode.rs
+++ b/drivers/gpu/drm/asahi/g15/encode.rs
@@ -69,6 +69,14 @@ pub(crate) const fn stamp_seed(seed: u32, n: u64) -> u32 {
     seed.wrapping_add((n as u32).wrapping_mul(0x100))
