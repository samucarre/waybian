     pub(crate) const PB_GROW: bool = true;
     /// The most PB blocks that may be posted: one below the mapped heap's block count, so the
diff --git a/drivers/gpu/drm/asahi/g15/params.rs b/drivers/gpu/drm/asahi/g15/params.rs
index 48d21e45d0acd6..683b36c908e1d7 100644
