From f242d1b4cac346fff8cb00733a491f3e30fb8cbb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <soyminero11yt@gmail.com>
Date: Sun, 25 Oct 2026 17:59:36 +0100
Subject: [PATCH] media: apple: avd: av1: do not index reference_frame_ts with
 ref_frame_idx -1
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

For intra frames userspace passes ref_frame_idx[] = -1 (GStreamer
v4l2codecs does), and the AV1 path indexes reference_frame_ts[] with it
in seven places. UBSAN reports it on every key frame ("index -1 is out of
range for type 'const __u64[8]'" at avd-av1.c:451, 481, 581 and 582): the
read lands on the bytes in front of the array.

Read the timestamps through avd_av1_ref_ts(), which returns U64_MAX for an
invalid index. That matches no capture buffer, so avd_get_ref_buf() falls
back to the destination as for any unused reference, and two invalid slots
still compare equal in set_ref_hdr(): the stream sent to the hardware does
not change.

Generated-by: LLM
Signed-off-by: Samuel Carreño <soyminero11yt@gmail.com>
---
 drivers/media/platform/apple/avd/avd-av1.c | 47 +++++++++++++---------
 1 file changed, 28 insertions(+), 19 deletions(-)

diff --git a/drivers/media/platform/apple/avd/avd-av1.c b/drivers/media/platform/apple/avd/avd-av1.c
index 113edc267fd331f..bec2a1c2315cb85 100644
--- a/drivers/media/platform/apple/avd/avd-av1.c
+++ b/drivers/media/platform/apple/avd/avd-av1.c
@@ -332,6 +332,22 @@ avd_av1_dec_get_shear_params(const u32 *params, s64 *alpha,
 		* (1 << WARP_PARAM_REDUCE_BITS);
 }
 
+/*
+ * Timestamp of the reference in slot @slot of ref_frame_idx[] (0 = LAST ... 6 = ALTREF). Userspace
+ * passes -1 for the references of intra frames, and indexing reference_frame_ts[] with it reads the
+ * bytes in front of the array. An invalid index gives U64_MAX, which matches no capture buffer, so
+ * avd_get_ref_buf() falls back to the destination, as for any unused reference; two invalid slots
+ * still compare equal, as before.
+ */
+static u64 avd_av1_ref_ts(const struct v4l2_ctrl_av1_frame *frame, int slot)
+{
+	s8 idx = frame->ref_frame_idx[slot];
+
+	if (idx < 0 || idx >= V4L2_AV1_TOTAL_REFS_PER_FRAME)
+		return U64_MAX;
+	return frame->reference_frame_ts[idx];
+}
