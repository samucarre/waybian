+    if let Some(s) = data.size {
+        lines.push(glib::format_size(s).to_string());
+    }
+    Shown {
+        name: data.name,
+        details: lines.join("\n"),
+        content_type: data.content_type,
+        texture: data.texture,
+    }
+}
