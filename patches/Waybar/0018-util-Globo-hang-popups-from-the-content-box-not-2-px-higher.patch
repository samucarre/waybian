From 7eb1b82bbf53c481de00d86ad7a3983e8aec7795 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <samucarre@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:17:16 +0100
Subject: [PATCH 18/21] util/Globo: hang popups from the content box (not 2 px
 higher); hyprland/workspaces buttons get the bar's own tooltip

gap(): the root's height in GTK4 is its content height, which already ends above
the window's CSS bottom border, so subtracting the border width again placed the
tooltips and menus 2 px too high over a bar with a border line (seen on the big
screen: the ear ring started two rows above the bar's line).

hyprland/workspaces: each workspace button set a plain GTK tooltip (its name),
the only tooltips in the bar still drawn by GTK. The button now owns a
util::Globo fed from the same tooltip text, wired to the button's enter/leave
and hidden on press, so it hangs from the bar like every other tooltip.

Debug logging in Globo::enter/leave/pointerInside (spdlog debug level).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013Fj1pDmXVTEisPZxhYu6xF
---
 include/modules/hyprland/workspace.hpp |  4 ++++
 include/util/globo.hpp                 |  4 ++--
 src/modules/hyprland/workspace.cpp     | 12 ++++++++++-
 src/util/globo.cpp                     | 29 ++++++++++++++++----------
 4 files changed, 35 insertions(+), 14 deletions(-)

diff --git a/include/modules/hyprland/workspace.hpp b/include/modules/hyprland/workspace.hpp
index 885a869..7a35025 100644
--- a/include/modules/hyprland/workspace.hpp
+++ b/include/modules/hyprland/workspace.hpp
@@ -20,6 +20,7 @@
 #include "modules/hyprland/backend.hpp"
 #include "modules/hyprland/windowcreationpayload.hpp"
 #include "util/enum.hpp"
+#include "util/globo.hpp"
 #include "util/regex_collection.hpp"
 
 using WindowAddress = std::string;
@@ -99,6 +100,9 @@ class Workspace {
   Gtk::Box m_content_;
   Gtk::Label m_labelBefore_;
   Gtk::Label m_labelAfter_;
+  // The bar's own tooltip for the button (util::Globo, hanging from the bar like the modules' ones); GTK's stays off.
+  // Declared after m_button_ so it is destroyed first (it unparents its popover from the button).
+  std::unique_ptr<util::Globo> m_globo_;
 
   IPC& m_ipc_;
 };
diff --git a/include/util/globo.hpp b/include/util/globo.hpp
index 37fe2e0..0a7c2fd 100644
--- a/include/util/globo.hpp
+++ b/include/util/globo.hpp
@@ -21,8 +21,8 @@ class Globo : public sigc::trackable {
   void leave();    // pointer left: cancel and hide
   void hide();     // hide now (click, destruction)
   void refresh();  // the text changed: update the popup if it is visible
-  // Pixels between the bottom edge of `w` and the bottom edge of its window, minus the window's bottom border:
-  // a popup offset by this hangs from the bar's edge and covers the bar's border line.
+  // Pixels between the bottom edge of `w` and the bottom edge of its window's content box (which ends above the
+  // window's CSS bottom border): a popup offset by this hangs from the bar and covers the bar's border line.
   static int gap(Gtk::Widget& w);
   Gtk::Widget& anchor() const { return anchor_; }
 
diff --git a/src/modules/hyprland/workspace.cpp b/src/modules/hyprland/workspace.cpp
index 32ddde3..64e3e0a 100644
--- a/src/modules/hyprland/workspace.cpp
+++ b/src/modules/hyprland/workspace.cpp
@@ -72,6 +72,10 @@ Workspace::Workspace(const Json::Value& workspace_data, Workspaces& workspace_ma
   controller_motion->signal_leave().connect(sigc::mem_fun(*this, &Workspace::handleLeave));
   m_button_.add_controller(controller_motion);
 
+  // the bar's own tooltip instead of GTK's (3-nov-2026): the text set with set_tooltip_text() stays in the button
+  m_globo_ = std::make_unique<util::Globo>(
+      m_button_, [this] { return Glib::Markup::escape_text(m_button_.get_tooltip_text()); });
+
   m_button_.add_css_class("flat");
   if (m_workspaceManager_.enableTaskbar()) {
     m_content_.set_orientation(m_workspaceManager_.taskbarOrientation());
@@ -113,11 +117,16 @@ std::optional<WindowRepr> Workspace::closeWindow(WindowAddress const& addr) {
 
 void Workspace::handleEnter(double x, double y) {
   m_button_.get_style_context()->add_class("workspace-hover");
+  if (m_globo_) m_globo_->enter();
 }
 
-void Workspace::handleLeave() { m_button_.get_style_context()->remove_class("workspace-hover"); }
+void Workspace::handleLeave() {
+  m_button_.get_style_context()->remove_class("workspace-hover");
+  if (m_globo_) m_globo_->leave();
+}
 
 void Workspace::handlePress(int n_press, double x, double y) {
+  if (m_globo_) m_globo_->hide();
   try {
     if (id() > 0) {  // normal
       if (m_workspaceManager_.moveToMonitor()) {
@@ -407,6 +416,7 @@ void Workspace::doUpdate(const std::string& workspace_icon, const std::string& w
     m_button_.set_tooltip_text(
         fmt::format(fmt::runtime(workspace_tooltip), fmt::arg("id", id()), fmt::arg("name", name()),
                     fmt::arg("icon", workspace_icon), fmt::arg("windows", windows)));
+    if (m_globo_) m_globo_->refresh();
   }
 
   auto formatBefore = m_workspaceManager_.formatBefore();
diff --git a/src/util/globo.cpp b/src/util/globo.cpp
index 6ec38dc..71ab873 100644
--- a/src/util/globo.cpp
+++ b/src/util/globo.cpp
@@ -2,6 +2,8 @@
 
 #include <gtk/gtk.h>
 
+#include <spdlog/spdlog.h>
+
 #include <cmath>
 
 namespace waybar::util {
@@ -41,16 +43,15 @@ int Globo::gap(Gtk::Widget& w) {
   if (root == nullptr) return 0;
   graphene_rect_t b;
   if (!gtk_widget_compute_bounds(w.gobj(), GTK_WIDGET(root), &b)) return 0;
-  int h = gtk_widget_get_height(GTK_WIDGET(root)) - static_cast<int>(std::lround(b.origin.y + b.size.height));
-  if (h < 0) h = 0;
-  // Climb over the bar's bottom border (its "line", when the CSS draws one): the popup's own outline carries that
-  // line on around itself instead of the bar's line cutting across the top of the popup.
-  GtkBorder border;
-  gtk_style_context_get_border(gtk_widget_get_style_context(GTK_WIDGET(root)), &border);
-  return h - border.bottom;
+  // The root's height is its CONTENT height (GTK4), which already stops above the bar's bottom border: a popup
+  // offset by this gap starts right over the border line (the bar's "line"), so the popup's own outline can carry
+  // the line on around itself. Subtracting the border here again put the popups 2 px too high (3-nov-2026).
+  const int h = gtk_widget_get_height(GTK_WIDGET(root)) - static_cast<int>(std::lround(b.origin.y + b.size.height));
+  return h > 0 ? h : 0;
 }
 
 void Globo::enter() {
+  spdlog::debug("globo: enter");
   timer_.disconnect();
   // GTK's tooltip timings: 500 ms, or 60 ms in "browse mode" right after another tooltip closed
   const bool browse = std::chrono::steady_clock::now() - lastHide_ < std::chrono::milliseconds(500);
@@ -63,6 +64,7 @@ void Globo::enter() {
 }
 
 void Globo::leave() {
+  spdlog::debug("globo: leave");
   timer_.disconnect();
   hide();
 }
@@ -97,13 +99,18 @@ bool Globo::pointerInside() const {
   if (surface == nullptr || pointer == nullptr) return true;  // unknown: trust the crossing events
   double sx = 0, sy = 0;
   GdkModifierType mask;
-  if (!gdk_surface_get_device_position(surface, pointer, &sx, &sy, &mask)) return false;  // not over the bar
+  const bool over = gdk_surface_get_device_position(surface, pointer, &sx, &sy, &mask);
   double nx = 0, ny = 0;
   gtk_native_get_surface_transform(native, &nx, &ny);
   graphene_point_t p = GRAPHENE_POINT_INIT(static_cast<float>(sx - nx), static_cast<float>(sy - ny));
-  graphene_point_t out;
-  if (!gtk_widget_compute_point(GTK_WIDGET(native), w, &p, &out)) return true;
-  return gtk_widget_contains(w, out.x, out.y);
+  graphene_point_t out = GRAPHENE_POINT_INIT(0, 0);
+  const bool computed = gtk_widget_compute_point(GTK_WIDGET(native), w, &p, &out);
+  const bool inside = computed && gtk_widget_contains(w, out.x, out.y);
+  spdlog::debug("globo: over={} pos=({:.1f},{:.1f}) transform=({:.1f},{:.1f}) computed={} local=({:.1f},{:.1f}) inside={}",
+                over, sx, sy, nx, ny, computed, out.x, out.y, inside);
+  if (!over) return false;  // not over the bar
+  if (!computed) return true;
+  return inside;
 }
 
 void Globo::show() {
