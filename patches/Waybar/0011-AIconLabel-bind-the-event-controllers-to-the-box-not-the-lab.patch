From fff9bf3ecc16de7db5fa4d20e283bd68f2bdb3d6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <soyminero11yt@gmail.com>
Date: Tue, 27 Oct 2026 11:02:03 +0100
Subject: [PATCH] AIconLabel: bind the event controllers to the box, not the
 label

ALabel binds the click/scroll/motion controllers in its constructor,
when the module's widget is still the label; AIconLabel then swaps the
widget for its box, so the gestures stayed on the label and clicks on
the box (or on the untargetable children) never reached them. Rebind
them to the box once it is the module's widget. Also log every click at
debug level (module, button, n_press, position).
---
 src/AIconLabel.cpp | 4 ++++
 src/AModule.cpp    | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/src/AIconLabel.cpp b/src/AIconLabel.cpp
index 4723f160f..4e5c2232d 100644
--- a/src/AIconLabel.cpp
+++ b/src/AIconLabel.cpp
@@ -67,6 +67,10 @@ AIconLabel::AIconLabel(const Json::Value& config, const std::string& name, const
    * label or the image would never reach them. Let the box be the only target. */
   label_.set_can_target(false);
   image_.set_can_target(false);
+  /* ALabel bound the click/scroll/motion controllers while the module's widget was still the
+   * label: move them to the box, now that it is the module's widget and the only event target. */
+  AModule::unBindEvents();
+  AModule::bindEvents(*this);
 }
 
 std::tuple<std::string, std::string> AIconLabel::extractIcon(const std::string& input) {
