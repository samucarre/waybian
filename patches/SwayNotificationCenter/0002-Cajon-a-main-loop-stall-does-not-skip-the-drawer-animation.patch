From 892ca015d4b30e7554d17c57e43a5050a2f16c59 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Samuel=20Carre=C3=B1o?= <samucarre@users.noreply.github.com>
Date: Tue, 3 Nov 2026 11:18:40 +0100
Subject: [PATCH 2/4] Cajon: a main-loop stall does not skip the drawer
 animation

Creating the blank windows of the other monitors when the control center maps
can block the main loop for hundreds of milliseconds right after the first
frame; the drawer then jumped to its final size with no frame in between. A gap
of more than 80 ms between ticks now shifts the animation origin instead.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013Fj1pDmXVTEisPZxhYu6xF
---
 src/cajon.vala | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/cajon.vala b/src/cajon.vala
index 590209a..4044d19 100644
--- a/src/cajon.vala
+++ b/src/cajon.vala
@@ -8,6 +8,7 @@ namespace SwayNotificationCenter {
         private Gtk.Widget ? hijo = null;
         private double escala = 1.0;
         private int64 t0 = 0;
+        private int64 t_prev = 0;
         private uint tick = 0;
         private const double DURACION = 0.7;
 
@@ -60,6 +61,7 @@ namespace SwayNotificationCenter {
             }
             escala = 0.12;
             t0 = 0;
+            t_prev = 0;
             if (tick != 0) {
                 remove_tick_callback (tick);
             }
@@ -67,7 +69,15 @@ namespace SwayNotificationCenter {
                 int64 t = clock.get_frame_time ();
                 if (t0 == 0) {
                     t0 = t;
+                    t_prev = t;
                 }
+                // Un parón del bucle (la creación de las ventanas en blanco de las otras pantallas al mapearse,
+                // >80 ms) no se descuenta de la animación: se desplaza el origen y el cajón sigue donde estaba,
+                // en vez de saltar al final sin que se vea ningún fotograma.
+                if (t - t_prev > 80000) {
+                    t0 += (t - t_prev) - 16000;
+                }
+                t_prev = t;
                 double p = (double) (t - t0) / 1e6 / DURACION;
                 escala = escala_suave (p);
                 queue_draw ();
-- 
